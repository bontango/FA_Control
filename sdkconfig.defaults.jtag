# Zusatz fuer die Board-Variante "JTAG-Piggyback an P5" (ESP32_jtag_piggyback).
# Wird NACH sdkconfig.defaults gelesen und mit eigener sdkconfig gebaut, damit
# sich die Varianten nicht gegenseitig ueberschreiben:
#
#   idf.py -B C:\Users\bonta\esp\build\fa_jtag -D SDKCONFIG=C:\Users\bonta\esp\build\fa_jtag\sdkconfig
#          -D "SDKCONFIG_DEFAULTS=sdkconfig.defaults;sdkconfig.defaults.jtag" build
#
# Konsole bleibt wie beim Sockel: GPIO20/21 sind hier frei.

CONFIG_FA_BOARD_JTAG_PIGGYBACK=y
