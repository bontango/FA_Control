CONFIG_IDF_TARGET="esp32c3"

# Partition table: two OTA partitions (1.5 MB each) for web-based firmware updates
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# Konsole ueber USB-Serial-JTAG, auf allen Boards (seit v1.31 ein Image):
# GPIO20/21 (UART0) sind auf dem Sockel nicht beschaltet, auf Board v7 CONF_DONE
# und TDO. Das Boot-Log des ROM auf GPIO21 bleibt, siehe board_pins.h.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# Logging
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# HTTP server
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512

# WiFi: reduce buffers for a small footprint
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16

# LWIP
CONFIG_LWIP_MAX_SOCKETS=10
