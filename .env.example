# SFTP-Zugangsdaten fuer build_and_deploy.ps1
# Datei kopieren: copy .env.example .env
# Dann .env mit echten Zugangsdaten befuellen (wird NICHT in Git eingecheckt)

SFTP_HOST=sftp.example.com
SFTP_USER=mein_sftp_benutzer
# Zielverzeichnis auf dem Server, z.B. .../swrep/misc/FA_Control/bin
# Nur die Anwendung, das ist die Quelle fuer das OTA-Update im Geraet.
SFTP_PATH=/pfad/auf/dem/server

# Fuer build_and_deploy_full.ps1: das komplette Flash-Paket (Bootloader,
# Partitionstabelle, OTA-Daten, Anwendung + version.txt), z.B.
# .../swrep/misc/FA_Control/esptool
SFTP_PATH_FULL=/pfad/fuer/full_flash_paket

# Fuer flasher\deploy_flasher.ps1: die USB-Installerseite und ihre Anleitung,
# z.B. .../swrep/misc/FA_Control/flasher
SFTP_PATH_WEB=/pfad/fuer/installerseite

# Optional: Lokales Zielverzeichnis (Standard: releases\)
# LOCAL_RELEASES_DIR=releases

# Optional: Lokales Build-Verzeichnis (Standard: C:\Users\bonta\esp\build\fa)
# BUILD_DIR=C:\Users\bonta\esp\build\fa

# Optional: ESP-IDF venv-Pfad ueberschreiben falls falsche Python-Version erkannt wird
# IDF_PYTHON_ENV_PATH=C:\Users\bonta\.espressif\python_env\idf5.5_py3.11_env
